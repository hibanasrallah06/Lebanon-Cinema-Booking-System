# MySQL
CINEMA_DB_URL=jdbc:mysql://localhost:3306/cinema_booking_system
CINEMA_DB_USER=root
CINEMA_DB_PASSWORD=your_mysql_password

# Gmail SMTP (use a Gmail App Password, not your normal password)
CINEMA_SENDER_EMAIL=your_email@gmail.com
CINEMA_EMAIL_APP_PASSWORD=your_gmail_app_password

# TMDB API
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
