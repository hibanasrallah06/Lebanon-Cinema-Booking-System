<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cinemasystem.controller.NewCustomerController"
      spacing="18"
      prefWidth="700"
      prefHeight="500"
      minWidth="700"
      minHeight="500"
      style="-fx-background-color:#ECECEC;
             -fx-padding:40;">

    <!-- ========================= -->
    <!-- TITLE -->
    <!-- ========================= -->

    <Label text="Add Customer"
           style="-fx-text-fill:#243447;
                  -fx-font-size:40px;
                  -fx-font-weight:bold;"/>


    <!-- ========================= -->
    <!-- CUSTOMER NAME -->
    <!-- ========================= -->

    <HBox spacing="20"
          alignment="CENTER_LEFT">

        <Label text="Name:"
               prefWidth="90"
               style="-fx-text-fill:#243447;
                      -fx-font-size:17px;"/>

        <TextField fx:id="txtCustomerName"
                   promptText="Enter customer name"
                   prefHeight="38"
                   maxWidth="Infinity"
                   HBox.hgrow="ALWAYS"/>

    </HBox>


    <!-- ========================= -->
    <!-- PHONE -->
    <!-- ========================= -->

    <HBox spacing="20"
          alignment="CENTER_LEFT">

        <Label text="Phone:"
               prefWidth="90"
               style="-fx-text-fill:#243447;
                      -fx-font-size:17px;"/>

        <TextField fx:id="txtCustomerPhone"
                   promptText="Enter phone number"
                   prefHeight="38"
                   maxWidth="Infinity"
                   HBox.hgrow="ALWAYS"/>

    </HBox>


    <!-- ========================= -->
    <!-- EMAIL -->
    <!-- ========================= -->

    <HBox spacing="20"
          alignment="CENTER_LEFT">

        <Label text="Email:"
               prefWidth="90"
               style="-fx-text-fill:#243447;
                      -fx-font-size:17px;"/>

        <TextField fx:id="txtCustomerEmail"
                   promptText="Enter email address"
                   prefHeight="38"
                   maxWidth="Infinity"
                   HBox.hgrow="ALWAYS"/>

    </HBox>


    <Region VBox.vgrow="ALWAYS"/>


    <!-- ========================= -->
    <!-- BUTTONS -->
    <!-- ========================= -->

    <HBox spacing="15"
          alignment="CENTER_LEFT">

        <Button fx:id="btnSave"
                onAction="#handleSave"
                text="Save"
                prefWidth="150"
                prefHeight="45"
                style="-fx-background-color:#2E7D32;
                       -fx-text-fill:white;
                       -fx-font-size:16px;
                       -fx-font-weight:bold;
                       -fx-background-radius:5;
                       -fx-cursor:hand;"/>

        <Button fx:id="btnCancel"
                onAction="#handleCancel"
                text="Cancel"
                prefWidth="150"
                prefHeight="45"
                style="-fx-background-color:#EEEEEE;
                       -fx-text-fill:#222222;
                       -fx-font-size:16px;
                       -fx-background-radius:5;
                       -fx-border-color:#BBBBBB;
                       -fx-border-radius:5;
                       -fx-cursor:hand;"/>

    </HBox>

</VBox>