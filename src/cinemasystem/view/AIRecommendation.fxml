<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1100.0"
        prefHeight="700.0"
        minWidth="700.0"
        minHeight="500.0"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.AIRecommendationController"
        style="-fx-background-color:#ECECEC;">

    <!-- ================= HEADER ================= -->

    <top>
        <VBox
                spacing="10"
                style="
                    -fx-background-color:#111111;
                    -fx-padding:16 45 18 45;
                    -fx-border-color:#F4C542;
                    -fx-border-width:0 0 3 0;
                ">

            <HBox alignment="CENTER_LEFT">

                <Button
                        onAction="#handleBack"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="
                            -fx-background-color:#2B2B2B;
                            -fx-text-fill:white;
                            -fx-font-size:15px;
                            -fx-font-weight:bold;
                            -fx-background-radius:8;
                            -fx-border-color:#444444;
                            -fx-border-radius:8;
                            -fx-cursor:hand;
                        "/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="
                            -fx-text-fill:#BDBDBD;
                            -fx-font-size:15px;
                            -fx-font-weight:bold;
                        "/>

            </HBox>

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="🤖"
                        style="
                            -fx-font-size:30px;
                            -fx-text-fill:#F4C542;
                        "/>

                <VBox spacing="2">

                    <Label
                            text="AI Movie Recommendations"
                            style="
                                -fx-text-fill:white;
                                -fx-font-size:30px;
                                -fx-font-weight:bold;
                            "/>

                    <Label
                            text="Find the perfect movie based on your preferences"
                            style="
                                -fx-text-fill:#BDBDBD;
                                -fx-font-size:15px;
                            "/>

                </VBox>

            </HBox>

        </VBox>
    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="
                    -fx-background-color:#ECECEC;
                    -fx-border-width:0;
                ">

            <content>

                <VBox
                        spacing="25"
                        fillWidth="true"
                        style="
                            -fx-background-color:#ECECEC;
                            -fx-padding:35 45 45 45;
                        ">


                    <!-- ================================================= -->
                    <!-- INPUT + OUTPUT SIDE BY SIDE -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="25"
                            alignment="TOP_LEFT"
                            fillHeight="true">


                        <!-- ================= INPUT CARD ================= -->

                        <VBox
                                prefWidth="500"
                                minWidth="350"
                                HBox.hgrow="ALWAYS"
                                spacing="18"
                                style="
                                    -fx-background-color:white;
                                    -fx-background-radius:18;
                                    -fx-padding:28;
                                    -fx-effect:
                                        dropshadow(
                                            gaussian,
                                            rgba(0,0,0,0.10),
                                            12,
                                            0,
                                            0,
                                            4
                                        );
                                ">

                            <VBox spacing="5">

                                <Label
                                        text="What are you looking for?"
                                        style="
                                            -fx-text-fill:#080808;
                                            -fx-font-size:25px;
                                            -fx-font-weight:bold;
                                        "/>

                                <Label
                                        text="Describe the type of movie you want and let AI find the best match."
                                        wrapText="true"
                                        style="
                                            -fx-text-fill:#718096;
                                            -fx-font-size:15px;
                                        "/>

                            </VBox>


                            <!-- INPUT -->

                            <VBox spacing="8">

                                <Label
                                        text="Your Movie Preferences"
                                        style="
                                            -fx-text-fill:#334155;
                                            -fx-font-size:15px;
                                            -fx-font-weight:bold;
                                        "/>

                                <TextArea
                                        fx:id="txtRequest"
                                        promptText="Example: I want an action movie with a lot of adventure..."
                                        prefHeight="180"
                                        minHeight="130"
                                        wrapText="true"
                                        style="
                                            -fx-background-color:#F8FAFC;
                                            -fx-control-inner-background:#F8FAFC;
                                            -fx-background-radius:10;
                                            -fx-border-color:#D9E2EC;
                                            -fx-border-radius:10;
                                            -fx-padding:12;
                                            -fx-font-size:15px;
                                        "/>

                            </VBox>


                            <!-- RECOMMEND BUTTON -->

                            <Button
                                    fx:id="btnRecommend"
                                    onAction="#handleRecommendation"
                                    text="🤖   Get AI Recommendations"
                                    maxWidth="Infinity"
                                    prefHeight="55"
                                    style="
                                        -fx-background-color:#F4C542;
                                        -fx-text-fill:#080808;
                                        -fx-font-size:16px;
                                        -fx-font-weight:bold;
                                        -fx-background-radius:10;
                                        -fx-cursor:hand;
                                        -fx-effect:
                                            dropshadow(
                                                gaussian,
                                                rgba(0,0,0,0.12),
                                                8,
                                                0,
                                                0,
                                                3
                                            );
                                    "/>


                            <!-- STATUS -->

                            <Label
                                    fx:id="lblStatus"
                                    text=""
                                    wrapText="true"
                                    alignment="CENTER"
                                    maxWidth="Infinity"
                                    style="
                                        -fx-text-fill:#64748B;
                                        -fx-font-size:13px;
                                    "/>

                        </VBox>


                        <!-- ================= OUTPUT CARD ================= -->

                        <VBox
                                prefWidth="500"
                                minWidth="350"
                                HBox.hgrow="ALWAYS"
                                spacing="18"
                                style="
                                    -fx-background-color:white;
                                    -fx-background-radius:18;
                                    -fx-padding:28;
                                    -fx-effect:
                                        dropshadow(
                                            gaussian,
                                            rgba(0,0,0,0.10),
                                            12,
                                            0,
                                            0,
                                            4
                                        );
                                ">


                            <!-- OUTPUT TITLE -->

                            <VBox spacing="5">

                                <Label
                                        text="Recommended Movies"
                                        style="
                                            -fx-text-fill:#080808;
                                            -fx-font-size:27px;
                                            -fx-font-weight:bold;
                                        "/>

                                <Label
                                        text="Movies that match your request"
                                        style="
                                            -fx-text-fill:#718096;
                                            -fx-font-size:15px;
                                        "/>

                            </VBox>


                            <!-- EMPTY OUTPUT -->

                            <VBox
                                    fx:id="emptyBox"
                                    alignment="CENTER"
                                    spacing="10"
                                    minHeight="150"
                                    prefHeight="200"
                                    VBox.vgrow="ALWAYS"
                                    style="
                                        -fx-background-color:#F8FAFC;
                                        -fx-background-radius:12;
                                        -fx-padding:25;
                                        -fx-border-color:#E2E8F0;
                                        -fx-border-radius:12;
                                    ">

                                <Label
                                        text="🤖"
                                        style="
                                            -fx-font-size:35px;
                                        "/>

                                <Label
                                        text="Tell us what movie you're in the mood for"
                                        wrapText="true"
                                        alignment="CENTER"
                                        style="
                                            -fx-text-fill:#475569;
                                            -fx-font-size:15px;
                                            -fx-font-weight:bold;
                                        "/>

                                <Label
                                        text="Your AI recommendations will appear here."
                                        wrapText="true"
                                        alignment="CENTER"
                                        style="
                                            -fx-text-fill:#94A3B8;
                                            -fx-font-size:13px;
                                        "/>

                            </VBox>


                            <!-- AI RESULTS -->

                            <FlowPane
                                    fx:id="movieContainer"
                                    alignment="TOP_LEFT"
                                    hgap="15"
                                    vgap="15"
                                    prefWrapLength="450"
                                    minWidth="0"
                                    maxWidth="Infinity"
                                    VBox.vgrow="ALWAYS"/>

                        </VBox>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>