<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1100.0"
        prefHeight="700.0"
        minWidth="700.0"
        minHeight="500.0"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.CinemaController">

    <!-- ================= TOP ================= -->

    <top>

    <VBox
            spacing="12.0"
            style="-fx-background-color:#111111;
                   -fx-padding:20 48 22 48;
                   -fx-border-color:transparent transparent #2E7D32 transparent;
                   -fx-border-width:0 0 3 0;">

        <!-- Top Row -->

        <HBox
                alignment="CENTER_LEFT"
                prefWidth="Infinity">

            <Button
                    fx:id="btnBack"
                    onAction="#handleBack"
                    text="←  Dashboard"
                    prefWidth="166.0"
                    prefHeight="45.0"
                    style="-fx-background-color:#292929;
                           -fx-text-fill:white;
                           -fx-font-size:16px;
                           -fx-font-weight:bold;
                           -fx-background-radius:9;
                           -fx-border-color:#444444;
                           -fx-border-radius:9;
                           -fx-cursor:hand;"/>

            <Region
                    HBox.hgrow="ALWAYS"/>

            <Label
                    text="CINEMA SYSTEM"
                    style="-fx-text-fill:#BDBDBD;
                           -fx-font-size:16px;
                           -fx-font-weight:bold;"/>

        </HBox>


        <!-- Title -->

        <HBox
                alignment="CENTER_LEFT"
                spacing="12.0">

            <Label
                    text="🎬"
                    style="-fx-font-size:27px;"/>

            <VBox
                    spacing="3.0">

                <Label
                        text="Cinema Management"
                        style="-fx-text-fill:white;
                               -fx-font-size:36px;
                               -fx-font-weight:bold;"/>

                <Label
                        text="Manage cinemas, halls and their information"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;"/>

            </VBox>

        </HBox>

    </VBox>

</top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox
                spacing="20.0"
                fillWidth="true"
                style="-fx-padding:30;
                       -fx-background-color:#ECECEC;">

            <!-- ================= TABLES SIDE BY SIDE ================= -->

            <HBox
                    spacing="20.0"
                    VBox.vgrow="ALWAYS"
                    fillHeight="true">


                <!-- ================= CINEMAS ================= -->

                <VBox
                        spacing="15.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color:white;
                               -fx-padding:20;
                               -fx-background-radius:12;
                               -fx-border-radius:12;
                               -fx-border-color:#DDDDDD;">

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="🏢"
                                style="-fx-font-size:22px;"/>

                        <Label
                                text="Cinemas"
                                style="-fx-font-size:22px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"/>

                    </HBox>


                    <TableView
                            fx:id="tblCinemas"
                            onMouseClicked="#handleCinemaSelect"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            VBox.vgrow="ALWAYS">

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>

                        <columns>

                            <TableColumn
                                    fx:id="colCinemaId"
                                    text="ID"
                                    prefWidth="60.0"
                                    minWidth="50.0"/>

                            <TableColumn
                                    fx:id="colCinemaName"
                                    text="Cinema Name"
                                    prefWidth="160.0"
                                    minWidth="100.0"/>

                            <TableColumn
                                    fx:id="colAddress"
                                    text="Address"
                                    prefWidth="160.0"
                                    minWidth="100.0"/>

                            <TableColumn
                                    fx:id="colPhone"
                                    text="Phone"
                                    prefWidth="120.0"
                                    minWidth="90.0"/>

                            <TableColumn
                                    fx:id="colCity"
                                    text="City"
                                    prefWidth="120.0"
                                    minWidth="80.0"/>

                        </columns>

                    </TableView>


                    <!-- CINEMA BUTTONS -->

                    <FlowPane
                            hgap="10.0"
                            vgap="10.0"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity">

                        <Button
                                text="Add Cinema"
                                onAction="#handleAdd"
                                prefWidth="120.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#2E7D32;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                        <Button
                                text="Edit"
                                onAction="#handleEdit"
                                prefWidth="90.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#757575;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                        <Button
                                text="Delete"
                                onAction="#handleDelete"
                                prefWidth="90.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#D32F2F;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                    </FlowPane>

                </VBox>


                <!-- ================= HALLS ================= -->

                <VBox
                        spacing="15.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color:white;
                               -fx-padding:20;
                               -fx-background-radius:12;
                               -fx-border-radius:12;
                               -fx-border-color:#DDDDDD;">

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0">

                        <Label
                                text="🎬"
                                style="-fx-font-size:22px;"/>

                        <Label
                                text="Halls"
                                style="-fx-font-size:22px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"/>

                    </HBox>


                    <TableView
                            fx:id="tblHalls"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            VBox.vgrow="ALWAYS">

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>

                        <columns>

                            <TableColumn
                                    fx:id="colHallId"
                                    text="ID"
                                    prefWidth="70.0"
                                    minWidth="50.0"/>

                            <TableColumn
                                    fx:id="colHallName"
                                    text="Hall Name"
                                    prefWidth="180.0"
                                    minWidth="100.0"/>

                            <TableColumn
                                    fx:id="colCapacity"
                                    text="Capacity"
                                    prefWidth="120.0"
                                    minWidth="80.0"/>

                        </columns>

                    </TableView>


                    <!-- HALL BUTTONS -->

                    <FlowPane
                            hgap="10.0"
                            vgap="10.0"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity">

                        <Button
                                text="Add Hall"
                                onAction="#handleAddHall"
                                prefWidth="110.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#2E7D32;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                        <Button
                                text="Edit"
                                onAction="#handleEditHall"
                                prefWidth="90.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#757575;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                        <Button
                                text="Delete"
                                onAction="#handleDeleteHall"
                                prefWidth="90.0"
                                prefHeight="38.0"
                                style="-fx-background-color:#D32F2F;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:6;
                                       -fx-cursor:hand;"/>

                    </FlowPane>

                </VBox>

            </HBox>

        </VBox>

    </center>

</BorderPane>