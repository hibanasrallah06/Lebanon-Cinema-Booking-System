<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1200.0"
        prefHeight="750.0"
        minWidth="900.0"
        minHeight="600.0"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.ScheduleController"
        style="-fx-background-color:#ECECEC;">

    <!-- ========================================================= -->
    <!-- TOP -->
    <!-- ========================================================= -->

    <top>

        <VBox
                spacing="10"
                style="-fx-background-color:#111111;
                       -fx-padding:16 45 18 45;
                       -fx-border-color:#2E7D32;
                       -fx-border-width:0 0 3 0;">

            <!-- ================================================= -->
            <!-- BACK + SYSTEM -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT">

                <Button
                        onAction="#handleBack"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="-fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-border-color:#444444;
                               -fx-border-radius:8;
                               -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;"/>

            </HBox>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="🎬"
                        style="-fx-font-size:28px;"/>

                <VBox spacing="2">

                    <Label
                            text="Shows"
                            style="-fx-text-fill:white;
                                   -fx-font-size:30px;
                                   -fx-font-weight:bold;"/>

                    <Label
                            text="Manage movie schedules, halls and showtimes"
                            style="-fx-text-fill:#BDBDBD;
                                   -fx-font-size:15px;"/>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <VBox
                spacing="12"
                fillWidth="true"
                style="-fx-padding:30 45 30 45;
                       -fx-background-color:#ECECEC;">


            <!-- ================================================= -->
            <!-- SEARCH + ADD -->
            <!-- ================================================= -->

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <TextField
                        fx:id="txtSearch"
                        promptText="🔍  Search movie, hall, date or time..."
                        prefHeight="44"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color:white;
                               -fx-background-radius:8;
                               -fx-border-color:#DDDDDD;
                               -fx-border-radius:8;
                               -fx-padding:0 12;
                               -fx-font-size:14px;"/>


                <Button
                        fx:id="btnAdd"
                        onAction="#handleAdd"
                        text="+ Add Show"
                        prefWidth="140"
                        prefHeight="44"
                        style="-fx-background-color:#2E7D32;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-cursor:hand;"/>


                <Button
                        fx:id="btnEdit"
                        onAction="#handleEditSelected"
                        text="Edit"
                        prefWidth="95"
                        prefHeight="44"
                        visible="false"
                        managed="false"
                        style="-fx-background-color:#757575;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-cursor:hand;"/>


                <Button
                        fx:id="btnDelete"
                        onAction="#handleDeleteSelected"
                        text="Delete"
                        prefWidth="95"
                        prefHeight="44"
                        visible="false"
                        managed="false"
                        style="-fx-background-color:#D32F2F;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-cursor:hand;"/>

            </HBox>


            <!-- ================================================= -->
            <!-- CINEMA -->
            <!-- ================================================= -->

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <ComboBox
                        fx:id="cmbCinema"
                        promptText="Select Cinema"
                        prefWidth="300"
                        prefHeight="44"
                        style="-fx-background-color:white;
                               -fx-background-radius:8;
                               -fx-border-color:#DDDDDD;
                               -fx-border-radius:8;"/>

                <Region HBox.hgrow="ALWAYS"/>

            </HBox>


            <!-- ================================================= -->
            <!-- SHOW CARDS -->
            <!-- ================================================= -->

            <ScrollPane
                    fx:id="bodyScroll"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color:#ECECEC;
                           -fx-background:#ECECEC;
                           -fx-border-color:#D5D5D5;
                           -fx-border-radius:8;">

                <content>

                    <VBox
                            spacing="12"
                            fillWidth="true"
                            style="-fx-background-color:#ECECEC;
                                   -fx-padding:5;"/>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>