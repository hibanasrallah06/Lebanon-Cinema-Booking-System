<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<AnchorPane
        prefWidth="1100.0"
        prefHeight="750.0"
        minWidth="900.0"
        minHeight="650.0"
        style="-fx-background-color:#ECECEC;"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.ReportController">

    <children>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <VBox
                prefHeight="165"
                AnchorPane.topAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                style="-fx-background-color:#111111;
                       -fx-padding:16 45 18 45;
                       -fx-border-color:#2E7D32;
                       -fx-border-width:0 0 3 0;">

            <HBox alignment="CENTER_LEFT">

                <Button
                        fx:id="btnBack"
                        onAction="#handleBack"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="-fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-border-color:#444444;
                               -fx-border-radius:8;
                               -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;"/>

            </HBox>


            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="📊"
                        style="-fx-font-size:28px;"/>

                <VBox spacing="2">

                    <Label
                            text="Reports"
                            style="-fx-text-fill:white;
                                   -fx-font-size:30px;
                                   -fx-font-weight:bold;"/>

                    <Label
                            text="View sales, movies, cinemas and occupancy reports"
                            style="-fx-text-fill:#BDBDBD;
                                   -fx-font-size:15px;"/>

                </VBox>

            </HBox>

        </VBox>


        <!-- ===================================================== -->
        <!-- SCROLL PANE -->
        <!-- ===================================================== -->

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                AnchorPane.topAnchor="165"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                style="-fx-background-color:#ECECEC;
                       -fx-border-color:transparent;">

            <content>

                <VBox
                        spacing="15"
                        prefWidth="1000"
                        minHeight="1050"
                        style="-fx-padding:25 45 30 45;
                               -fx-background-color:#ECECEC;">


                    <!-- ================================================= -->
                    <!-- FILTERS -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="10"
                            alignment="CENTER_LEFT"
                            prefHeight="42"
                            minHeight="42">

                        <!-- CINEMA -->

                        <Label
                                fx:id="lblCinema"
                                text="Cinema:"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#333333;"/>


                        <ComboBox
                                fx:id="cmbCinema"
                                prefWidth="220"
                                prefHeight="42"
                                promptText="Select cinema"
                                onAction="#handleCinemaChanged"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:8;"/>


                        <!-- REPORT TYPE -->

                        <Label
                                text="Report:"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#333333;"/>


                        <ComboBox
                                fx:id="cmbReportType"
                                prefWidth="210"
                                prefHeight="42"
                                promptText="Select report type"
                                onAction="#handleReportTypeChanged"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:8;"/>


                        <!-- GENERATE -->

                        <Button
                                fx:id="btnGenerate"
                                text="Generate Report"
                                onAction="#handleGenerate"
                                prefWidth="160"
                                prefHeight="42"
                                style="-fx-background-color:#2E7D32;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:8;
                                       -fx-cursor:hand;"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- DATE FILTER -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="10"
                            alignment="CENTER_LEFT"
                            prefHeight="42"
                            minHeight="42">

                        <Label
                                text="From Date:"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#333333;"/>


                        <DatePicker
                                fx:id="dpFromDate"
                                prefWidth="180"
                                prefHeight="42"
                                promptText="Start date"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:8;"/>


                        <Label
                                text="To Date:"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#333333;"/>


                        <DatePicker
                                fx:id="dpToDate"
                                prefWidth="180"
                                prefHeight="42"
                                promptText="End date"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:8;"/>


                        <Label
                                text="Leave empty for all dates"
                                style="-fx-font-size:13px;
                                       -fx-text-fill:#777777;"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- STATISTICS -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="15"
                            prefHeight="105"
                            minHeight="105"
                            maxHeight="105">

                        <!-- REVENUE -->

                        <VBox
                                alignment="CENTER"
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Total Revenue"
                                    style="-fx-font-size:14px;
                                           -fx-text-fill:#777777;"/>

                            <Label
                                    fx:id="lblRevenue"
                                    text="0.00 $"
                                    style="-fx-font-size:24px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#2E7D32;"/>

                        </VBox>


                        <!-- TICKETS -->

                        <VBox
                                alignment="CENTER"
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Tickets Sold"
                                    style="-fx-font-size:14px;
                                           -fx-text-fill:#777777;"/>

                            <Label
                                    fx:id="lblTickets"
                                    text="0"
                                    style="-fx-font-size:24px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#222222;"/>

                        </VBox>


                        <!-- SHOWS -->

                        <VBox
                                alignment="CENTER"
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Total Shows"
                                    style="-fx-font-size:14px;
                                           -fx-text-fill:#777777;"/>

                            <Label
                                    fx:id="lblShows"
                                    text="0"
                                    style="-fx-font-size:24px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#222222;"/>

                        </VBox>


                        <!-- OCCUPANCY -->

                        <VBox
                                alignment="CENTER"
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Occupancy"
                                    style="-fx-font-size:14px;
                                           -fx-text-fill:#777777;"/>

                            <Label
                                    fx:id="lblOccupancy"
                                    text="0%"
                                    style="-fx-font-size:24px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#222222;"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- BAR + PIE -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="20"
                            prefHeight="320"
                            minHeight="320"
                            maxHeight="320">


                        <!-- BAR -->

                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Performance Comparison"
                                    style="-fx-font-size:20px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#222222;"/>


                            <BarChart
                                    fx:id="barChart"
                                    animated="false"
                                    legendVisible="true"
                                    VBox.vgrow="ALWAYS">

                                <xAxis>

                                    <CategoryAxis
                                            fx:id="barXAxis"
                                            label="Movie / Cinema"/>

                                </xAxis>


                                <yAxis>

                                    <NumberAxis
                                            fx:id="barYAxis"
                                            label="Revenue / Tickets"
                                            forceZeroInRange="true"/>

                                </yAxis>

                            </BarChart>

                        </VBox>


                        <!-- PIE -->

                        <VBox
                                spacing="8"
                                prefWidth="400"
                                minWidth="350"
                                style="-fx-background-color:white;
                                       -fx-background-radius:10;
                                       -fx-padding:15;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:10;">

                            <Label
                                    text="Distribution"
                                    style="-fx-font-size:20px;
                                           -fx-font-weight:bold;
                                           -fx-text-fill:#222222;"/>


                            <PieChart
                                    fx:id="pieChart"
                                    animated="false"
                                    legendVisible="true"
                                    VBox.vgrow="ALWAYS"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- DATE / TREND LINE CHART -->
                    <!-- ================================================= -->

                    <VBox
                            spacing="8"
                            prefHeight="400"
                            minHeight="400"
                            maxHeight="400"
                            style="-fx-background-color:white;
                                   -fx-background-radius:10;
                                   -fx-padding:15;
                                   -fx-border-color:#DDDDDD;
                                   -fx-border-radius:10;">


                        <Label
                                fx:id="lblLineChartTitle"
                                text="Revenue Trend"
                                style="-fx-font-size:20px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"/>


                        <LineChart
                                fx:id="lineChart"
                                animated="false"
                                createSymbols="true"
                                legendVisible="false"
                                VBox.vgrow="ALWAYS">

                            <xAxis>

                                <CategoryAxis
                                        fx:id="lineXAxis"
                                        label="Date"/>

                            </xAxis>


                            <yAxis>

                                <NumberAxis
                                        fx:id="lineYAxis"
                                        label="Revenue ($)"
                                        forceZeroInRange="true"/>

                            </yAxis>

                        </LineChart>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- EXPORT -->
                    <!-- ================================================= -->

                    <HBox
                            spacing="15"
                            alignment="CENTER_RIGHT"
                            prefHeight="42"
                            minHeight="42"
                            maxHeight="42">

                        <Button
                                fx:id="btnExport"
                                text="Export Report"
                                onAction="#handleExport"
                                prefWidth="150"
                                prefHeight="42"
                                style="-fx-background-color:#1565C0;
                                       -fx-text-fill:white;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:8;
                                       -fx-cursor:hand;"/>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </children>

</AnchorPane>