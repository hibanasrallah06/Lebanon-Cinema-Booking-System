<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.EmployeeController"
        style="-fx-background-color:#ECECEC;">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox
                spacing="10"
                style="-fx-background-color:#111111;
                       -fx-padding:16 45 18 45;
                       -fx-border-color:#2E7D32;
                       -fx-border-width:0 0 3 0;">

            <HBox alignment="CENTER_LEFT">

                <Button
                        fx:id="btnBack"
                        onAction="#handleDashboard"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="-fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-border-color:#444444;
                               -fx-border-radius:8;
                               -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;"/>

            </HBox>

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="👥"
                        style="-fx-font-size:28px;"/>

                <VBox spacing="2">

                    <Label
                            text="Employees"
                            style="-fx-text-fill:white;
                                   -fx-font-size:30px;
                                   -fx-font-weight:bold;"/>

                    <Label
                            text="Manage cinema employees and their information"
                            style="-fx-text-fill:#BDBDBD;
                                   -fx-font-size:15px;"/>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox
                spacing="18"
                fillWidth="true"
                style="-fx-padding:30 45 30 45;
                       -fx-background-color:#ECECEC;">

            <!-- SEARCH + ADD -->

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <TextField
                        fx:id="txtSearch"
                        promptText="🔍  Search employee..."
                        prefHeight="44"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color:white;
                               -fx-background-radius:8;
                               -fx-border-color:#DDDDDD;
                               -fx-border-radius:8;
                               -fx-padding:0 12;
                               -fx-font-size:14px;"/>

                <Button
                        fx:id="btnAddEmployee"
                        text="Add Employee"
                        onAction="#handleAddEmployee"
                        prefWidth="135"
                        prefHeight="44"
                        style="-fx-background-color:#2E7D32;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-cursor:hand;"/>

            </HBox>


            <!-- ================= EMPLOYEE CARDS ================= -->

            <ScrollPane
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color:transparent;
                           -fx-background:transparent;">

                <content>

                    <FlowPane
                            fx:id="employeeContainer"
                            hgap="18"
                            vgap="18"
                            prefWrapLength="1100"
                            style="-fx-padding:5;">

                    </FlowPane>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
