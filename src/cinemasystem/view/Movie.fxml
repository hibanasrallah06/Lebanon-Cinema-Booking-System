<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="1100.0"
        prefHeight="700.0"
        minWidth="700.0"
        minHeight="500.0"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.MovieController"
        style="-fx-background-color:#ECECEC;">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox
                spacing="10"
                style="-fx-background-color:#111111;
                       -fx-padding:16 45 18 45;
                       -fx-border-color:#2E7D32;
                       -fx-border-width:0 0 3 0;">

            <HBox alignment="CENTER_LEFT">

                <Button
                        fx:id="btnBack"
                        onAction="#handleBack"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="-fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-border-color:#444444;
                               -fx-border-radius:8;
                               -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;"/>

            </HBox>


            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="🎬"
                        style="-fx-font-size:28px;"/>

                <VBox spacing="2">

                    <Label
                            text="Movies"
                            style="-fx-text-fill:white;
                                   -fx-font-size:30px;
                                   -fx-font-weight:bold;"/>

                    <Label
                            text="Manage movies available in the cinema system"
                            style="-fx-text-fill:#BDBDBD;
                                   -fx-font-size:15px;"/>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox
                spacing="18"
                fillWidth="true"
                style="-fx-padding:30 45 30 45;
                       -fx-background-color:#ECECEC;">

            <!-- SEARCH + BUTTONS -->

            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <TextField
                        fx:id="txtSearch"
                        promptText="🔍  Search movie, genre..."
                        prefHeight="44"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color:white;
                               -fx-background-radius:8;
                               -fx-border-color:#DDDDDD;
                               -fx-border-radius:8;
                               -fx-padding:0 12;
                               -fx-font-size:14px;"/>


                <Button
                        fx:id="btnAdd"
                        onAction="#handleAdd"
                        text="Add Movie"
                        prefWidth="125"
                        prefHeight="44"
                        style="-fx-background-color:#2E7D32;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-cursor:hand;"/>

            </HBox>


            <!-- ================= MOVIE CARDS ================= -->

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER"
                    style="-fx-background-color:transparent;
                           -fx-background:transparent;">

                <content>

                    <FlowPane
                            fx:id="movieContainer"
                            hgap="20"
                            vgap="25"
                            alignment="TOP_LEFT"
                            prefWrapLength="950"
                            style="-fx-padding:5 5 25 5;
                                   -fx-background-color:transparent;"/>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>