<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        style="-fx-background-color:#ECECEC;"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.SnackController">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox
                spacing="10"
                style="-fx-background-color:#111111;
                       -fx-padding:16 45 18 45;
                       -fx-border-color:#2E7D32;
                       -fx-border-width:0 0 3 0;">

            <HBox alignment="CENTER_LEFT">

                <Button
                        onAction="#handleBack"
                        text="←  Dashboard"
                        prefWidth="145"
                        prefHeight="42"
                        style="-fx-background-color:#2B2B2B;
                               -fx-text-fill:white;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;
                               -fx-background-radius:8;
                               -fx-border-color:#444444;
                               -fx-border-radius:8;
                               -fx-cursor:hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="CINEMA SYSTEM"
                        style="-fx-text-fill:#BDBDBD;
                               -fx-font-size:15px;
                               -fx-font-weight:bold;"/>

            </HBox>


            <HBox
                    spacing="12"
                    alignment="CENTER_LEFT">

                <Label
                        text="🍿"
                        style="-fx-font-size:28px;"/>

                <VBox spacing="2">

                    <Label
                            text="Snacks"
                            style="-fx-text-fill:white;
                                   -fx-font-size:30px;
                                   -fx-font-weight:bold;"/>

                    <Label
                            text="Manage food and drinks available for cinema bookings"
                            style="-fx-text-fill:#BDBDBD;
                                   -fx-font-size:15px;"/>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color:#ECECEC;">

            <content>

                <VBox
                        spacing="20"
                        style="-fx-padding:30 45 30 45;">

                    <!-- SEARCH -->

                    <HBox
                            spacing="12"
                            alignment="CENTER_LEFT"
                            style="-fx-background-color:white;
                                   -fx-background-radius:10;
                                   -fx-padding:14;
                                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">

                        <TextField
                                fx:id="txtSearch"
                                promptText="🔍  Search snacks..."
                                prefHeight="42"
                                prefWidth="350"
                                style="-fx-background-color:#F5F5F5;
                                       -fx-background-radius:8;
                                       -fx-border-color:#DDDDDD;
                                       -fx-border-radius:8;
                                       -fx-padding:0 12;
                                       -fx-font-size:14px;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                    </HBox>


                    <!-- SNACK CARDS -->

                    <FlowPane
                            fx:id="snacksPane"
                            alignment="TOP_LEFT"
                            hgap="18"
                            vgap="18"
                            prefWrapLength="900"/>


                    <!-- SNACK DETAILS -->

                    <VBox
                            spacing="15"
                            style="-fx-background-color:white;
                                   -fx-background-radius:10;
                                   -fx-padding:22;
                                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">

                        <Label
                                text="Snack Details"
                                style="-fx-font-size:20px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"/>

                        <Separator/>


                        <HBox spacing="15">

                            <!-- NAME -->

                            <VBox
                                    spacing="6"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Snack Name"
                                        style="-fx-font-weight:bold;
                                               -fx-text-fill:#444444;"/>

                                <TextField
                                        fx:id="txtSnackName"
                                        prefHeight="40"
                                        promptText="e.g. Popcorn"/>

                            </VBox>


                            <!-- PRICE -->

                            <VBox
                                    prefWidth="170"
                                    spacing="6">

                                <Label
                                        text="Price"
                                        style="-fx-font-weight:bold;
                                               -fx-text-fill:#444444;"/>

                                <TextField
                                        fx:id="txtPrice"
                                        prefHeight="40"
                                        promptText="0.00"/>

                            </VBox>


                            <!-- STATUS -->

                            <VBox
                                    prefWidth="130"
                                    spacing="6">

                                <Label
                                        text="Status"
                                        style="-fx-font-weight:bold;
                                               -fx-text-fill:#444444;"/>

                                <CheckBox
                                        fx:id="chkActive"
                                        selected="true"
                                        text="Available"
                                        prefHeight="40"/>

                            </VBox>

                        </HBox>


                        <!-- BUTTONS -->

                        <HBox spacing="10">

                            <Button
                                    fx:id="btnSave"
                                    onAction="#handleSave"
                                    text="Save Snack"
                                    prefWidth="135"
                                    prefHeight="42"
                                    style="-fx-background-color:#2E7D32;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:8;
                                           -fx-cursor:hand;"/>


                            <Button
                                    fx:id="btnClear"
                                    onAction="#handleClear"
                                    text="Clear"
                                    prefWidth="100"
                                    prefHeight="42"
                                    style="-fx-background-color:#757575;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:8;
                                           -fx-cursor:hand;"/>


                            <Button
                                    fx:id="btnToggleStatus"
                                    onAction="#handleToggleStatus"
                                    text="Activate / Deactivate"
                                    prefWidth="180"
                                    prefHeight="42"
                                    style="-fx-background-color:#1976D2;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:8;
                                           -fx-cursor:hand;"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>