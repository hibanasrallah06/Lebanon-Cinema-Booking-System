<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefWidth="500.0"
        prefHeight="550.0"
        minWidth="450.0"
        minHeight="550.0"
        style="-fx-background-color:#F5F5F5;"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cinemasystem.controller.EditMovieController">

    <center>

        <ScrollPane
                fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color:#F5F5F5;">

            <content>

                <VBox
                        spacing="20.0"
                        fillWidth="true"
                        style="-fx-background-color:#F5F5F5;">

                    <padding>
                        <Insets
                                top="35.0"
                                right="40.0"
                                bottom="30.0"
                                left="40.0"/>
                    </padding>


                    <!-- HEADER -->

                    <VBox spacing="5.0">

                        <Label
                                text="Edit Movie"
                                style="-fx-font-size:30px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"/>

                        <Label
                                text="Update movie information"
                                style="-fx-font-size:15px;
                                       -fx-text-fill:#777777;"/>

                    </VBox>


                    <!-- FORM -->

                    <GridPane
                            hgap="15.0"
                            vgap="14.0"
                            maxWidth="Infinity">

                        <columnConstraints>

                            <ColumnConstraints
                                    minWidth="105.0"
                                    prefWidth="105.0"
                                    maxWidth="120.0"/>

                            <ColumnConstraints
                                    minWidth="250.0"
                                    hgrow="ALWAYS"
                                    fillWidth="true"/>

                        </columnConstraints>


                        <!-- TITLE -->

                        <Label
                                text="Title"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <TextField
                                fx:id="txtTitle"
                                prefHeight="48.0"
                                maxWidth="Infinity"
                                promptText="Enter movie title"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#CCCCCC;
                                       -fx-border-radius:8;
                                       -fx-padding:10;
                                       -fx-font-size:14px;"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>


                        <!-- DESCRIPTION -->

                        <Label
                                text="Description"
                                wrapText="true"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1"/>

                        <TextArea
                                fx:id="txtDescription"
                                prefHeight="110.0"
                                minHeight="90.0"
                                maxWidth="Infinity"
                                wrapText="true"
                                promptText="Enter movie description"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#CCCCCC;
                                       -fx-border-radius:8;
                                       -fx-padding:10;
                                       -fx-font-size:14px;"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1"/>


                        <!-- GENRES -->

                        <Label
                                text="Genres"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="2"/>


                        <VBox
                                fx:id="genreContainer"
                                spacing="8.0"
                                maxWidth="Infinity"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="2"/>


                        <!-- LANGUAGE -->

                        <Label
                                text="Language"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="3"/>

                        <ComboBox
                                fx:id="cmbLanguage"
                                prefHeight="48.0"
                                maxWidth="Infinity"
                                promptText="Select language"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#CCCCCC;
                                       -fx-border-radius:8;
                                       -fx-font-size:14px;"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="3"/>


                        <!-- DURATION -->

                        <Label
                                text="Duration"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="4"/>

                        <TextField
                                fx:id="txtDuration"
                                prefHeight="48.0"
                                maxWidth="Infinity"
                                promptText="Minutes"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#CCCCCC;
                                       -fx-border-radius:8;
                                       -fx-padding:10;
                                       -fx-font-size:14px;"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="4"/>


                        <!-- AGE RATING -->

                        <Label
                                text="Age Rating"
                                wrapText="true"
                                style="-fx-font-size:14px;
                                       -fx-font-weight:bold;
                                       -fx-text-fill:#222222;"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="5"/>

                        <ComboBox
                                fx:id="cmbAgeRating"
                                prefHeight="48.0"
                                maxWidth="Infinity"
                                promptText="Select age rating"
                                style="-fx-background-color:white;
                                       -fx-background-radius:8;
                                       -fx-border-color:#CCCCCC;
                                       -fx-border-radius:8;
                                       -fx-font-size:14px;"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="5"/>

                    </GridPane>


                    <!-- BUTTONS -->

                    <HBox
                            spacing="20.0"
                            maxWidth="Infinity">

                        <Button
                                fx:id="btnSave"
                                text="Save Changes"
                                onAction="#handleSave"
                                prefHeight="50.0"
                                maxWidth="Infinity"
                                style="-fx-background-color:#2E7D32;
                                       -fx-text-fill:white;
                                       -fx-font-size:16px;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:7;
                                       -fx-cursor:hand;"
                                HBox.hgrow="ALWAYS"/>

                        <Button
                                fx:id="btnCancel"
                                text="Cancel"
                                onAction="#handleCancel"
                                prefHeight="50.0"
                                maxWidth="Infinity"
                                style="-fx-background-color:#DDDDDD;
                                       -fx-text-fill:#222222;
                                       -fx-font-size:16px;
                                       -fx-font-weight:bold;
                                       -fx-background-radius:7;
                                       -fx-cursor:hand;"
                                HBox.hgrow="ALWAYS"/>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>