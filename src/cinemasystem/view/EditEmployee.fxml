<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cinemasystem.controller.EditEmployeeController"
      spacing="22"
      prefWidth="650"
      prefHeight="500"
      style="-fx-background-color:#ECECEC;
             -fx-padding:35 40 35 40;">

    <Label text="Edit Employee"
           style="-fx-font-size:36px;
                  -fx-font-weight:bold;
                  -fx-text-fill:#26384A;"/>


    <GridPane hgap="18"
              vgap="18">


        <!-- FULL NAME -->

        <Label text="Full Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"
               style="-fx-font-size:17px;"/>

        <TextField fx:id="txtFullName"
                   prefHeight="48"
                   prefWidth="390"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <!-- EMAIL -->

        <Label text="Email:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"
               style="-fx-font-size:17px;"/>

        <TextField fx:id="txtEmail"
                   promptText="Email address"
                   prefHeight="48"
                   prefWidth="390"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>


        <!-- PHONE -->

        <Label text="Phone:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"
               style="-fx-font-size:17px;"/>

        <TextField fx:id="txtPhone"
                   promptText="Phone number"
                   prefHeight="48"
                   prefWidth="390"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <!-- PASSWORD -->

        <Label text="New Password:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"
               style="-fx-font-size:17px;"/>

        <PasswordField fx:id="txtPassword"
                       promptText="Leave empty to keep current password"
                       prefHeight="48"
                       prefWidth="390"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"/>


        <!-- ROLE -->

        <Label text="Role:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"
               style="-fx-font-size:17px;"/>

        <ComboBox fx:id="cmbRole"
                  prefHeight="48"
                  prefWidth="390"
                  promptText="Select Role"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>


        <!-- CINEMA -->

        <Label text="Cinema:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"
               style="-fx-font-size:17px;"/>

        <ComboBox fx:id="cmbCinema"
                  prefHeight="48"
                  prefWidth="390"
                  promptText="Select Cinema"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="5"/>

    </GridPane>


    <!-- BUTTONS -->

    <HBox spacing="20"
          alignment="CENTER">

        <Button text="Update"
                onAction="#handleUpdate"
                prefWidth="170"
                prefHeight="52"
                style="-fx-background-color:#2E7D32;
                       -fx-text-fill:white;
                       -fx-font-size:17px;
                       -fx-font-weight:bold;"/>

        <Button text="Cancel"
                onAction="#handleCancel"
                prefWidth="170"
                prefHeight="52"
                style="-fx-font-size:17px;"/>

    </HBox>

</VBox>